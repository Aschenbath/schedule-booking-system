# ===== 时间 =====
# 覆盖“当前时间”（Asia/Shanghai）。留空则使用真实时间。
# 进程启动时以 NOW 为锚点，之后时钟正常前进（便于演示“到点提醒”）。
NOW=
# NOW_MODE=frozen 时时间完全冻结在 NOW
NOW_MODE=offset

# ===== 服务 =====
PORT=3000
DB_PATH=./data/app.db

# ===== 大模型 =====
# rules  : 离线规则模式，不调用任何大模型（测试 / 无 key 时使用）
# openai : 任意 OpenAI 兼容接口（/v1/chat/completions）
LLM_PROVIDER=rules
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=30000

# ===== 地图 =====
# mock : 内置模拟地图（默认）
# amap : 高德 Web 服务 API（需要 AMAP_KEY）
MAP_PROVIDER=mock
AMAP_KEY=
